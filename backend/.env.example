# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/graice?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# MFA Configuration
MFA_SERVICE_NAME=GRAICE_Assessment_Platform

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend base URL (invite / password-reset links)
CLIENT_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Service (Nodemailer / Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_APP_NAME=Mail
SMTP_FROM="GRAICE Platform <noreply@example.com>"
EMAIL_FROM="GRAICE Platform <noreply@example.com>"

# Cloudinary (optional until image uploads are used)
# Server starts without these; upload endpoints return CLOUDINARY_NOT_CONFIGURED (503)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=graice
